---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = await getCollection('articles');
articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Правен блог"
  description="Полезни статии и правни анализи от адвокатско съдружие 'Георгиев и Зънгарова' – Пловдив. Обжалване на наказателни постановления, административно право и други."
  canonical="https://georgiev.netlify.app/blog/"
>
  <header class="blog-header">
    <div class="container">
      <a href="/" class="back-link">&larr; Към началната страница</a>
      <h1 class="blog-title">Правен блог</h1>
      <p class="blog-subtitle">Полезни статии и правни анализи от нашия екип</p>
    </div>
  </header>
  <main class="blog-list container">
    {articles.map((article) => (
      <article class="blog-card">
        <a href={`/blog/${article.slug}/`} class="blog-card-link">
          <time class="blog-card-date">
            {new Date(article.data.pubDate).toLocaleDateString('bg-BG', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <h2 class="blog-card-title">{article.data.title}</h2>
          <p class="blog-card-desc">{article.data.description}</p>
          <span class="blog-card-cta">Прочети повече &rarr;</span>
        </a>
      </article>
    ))}
  </main>
</BaseLayout>

<style is:global>
  .blog-header {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 6rem 1.5rem 3rem;
  }
  .back-link {
    display: inline-block;
    color: var(--color-gold);
    font-size: 0.9375rem;
    margin-bottom: 2rem;
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--color-gold-light);
  }
  .blog-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-family: var(--font-heading);
    margin-bottom: 0.5rem;
  }
  .blog-subtitle {
    font-size: 1.125rem;
    color: var(--color-cream);
    opacity: 0.8;
  }
  .blog-list {
    padding: 3rem 1.5rem 4rem;
  }
  .blog-card {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-cream-dark);
    padding-bottom: 2rem;
  }
  .blog-card-link {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.2s;
  }
  .blog-card-link:hover {
    padding-left: 0.5rem;
  }
  .blog-card-date {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }
  .blog-card-title {
    font-size: 1.375rem;
    font-family: var(--font-heading);
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }
  .blog-card-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  .blog-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gold-dark);
  }
  .blog-card-link:hover .blog-card-cta {
    color: var(--color-gold);
  }
</style>
