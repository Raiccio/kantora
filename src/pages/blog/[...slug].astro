---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.data.title,
  "description": article.data.description,
  "datePublished": article.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Адвокатско съдружие \"Георгиев и Зънгарова\"",
    "url": "https://georgiev.netlify.app"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Адвокатско съдружие \"Георгиев и Зънгарова\"",
    "url": "https://georgiev.netlify.app"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://georgiev.netlify.app/blog/${article.slug}/`
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Начало", "item": "https://georgiev.netlify.app/" },
    { "@type": "ListItem", "position": 2, "name": "Блог", "item": "https://georgiev.netlify.app/blog/" },
    { "@type": "ListItem", "position": 3, "name": article.data.title }
  ]
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={`https://georgiev.netlify.app/blog/${article.slug}/`}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <header class="article-header">
    <div class="container">
      <a href="/" class="back-link">&larr; Към началната страница</a>
      <h1 class="article-title">{article.data.title}</h1>
      <p class="article-meta">
        Публикувано на {new Date(article.data.pubDate).toLocaleDateString('bg-BG', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
    </div>
  </header>
  <main class="article-body container">
    <Content />
  </main>
  <footer class="article-footer">
    <div class="container">
      <a href="/#contact" class="btn btn-primary">Свържете се с нас</a>
    </div>
  </footer>
</BaseLayout>

<style is:global>
  .article-header {
    background: var(--color-navy);
    color: var(--color-white);
    padding: 6rem 1.5rem 3rem;
  }

  .back-link {
    display: inline-block;
    color: var(--color-gold);
    font-size: 0.9375rem;
    margin-bottom: 2rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-gold-light);
  }

  .article-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 800px;
  }

  .article-meta {
    font-size: 0.875rem;
    color: var(--color-cream);
    opacity: 0.7;
    margin-top: 1rem;
  }

  .article-body {
    padding: 3rem 1.5rem 2rem;
    max-width: 800px;
    font-size: 1.0625rem;
    line-height: 1.8;
    text-align: justify;
  }

  .article-body h2 {
    font-size: 1.5rem;
    color: var(--color-navy);
    margin: 4rem 0 1.25rem;
  }

  .article-body h3 {
    font-size: 1.25rem;
    color: var(--color-navy);
    margin: 2.5rem 0 1rem;
  }

  .article-body p {
    margin-bottom: 1.5rem;
    text-indent: 2em;
  }

  .article-body ul {
    margin: 1.25rem 0 1.75rem 1.5rem;
  }

  .article-body li {
    margin-bottom: 0.75rem;
  }

  .article-body strong {
    color: var(--color-navy);
  }

  .article-footer {
    padding: 2rem 1.5rem 4rem;
    text-align: center;
  }

  .article-keywords {
    font-size: 0.75rem;
    color: var(--color-text-light);
    line-height: 1.8;
    margin-top: 0;
    text-align: left;
  }
</style>
